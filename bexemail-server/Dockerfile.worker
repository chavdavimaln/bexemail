# ─────────────────────────────────────────────────
# BullMQ Background Worker Dockerfile
# Runs all queue workers & cron jobs separately
# from the main API server
# ─────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

# ─────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src ./src
COPY package*.json ./

# The worker entrypoint only boots the queue processor,
# not the express HTTP server
CMD ["node", "-e", "\
  require('dotenv').config();\
  require('./src/workers/worker');\
  require('./src/workers/cron');\
  require('./src/workers/cleanupCron');\
  require('./src/workers/automationProcessor');\
  require('./src/workers/automationCron');\
  require('./src/workers/abTestCron');\
  console.log('BexEmail Worker Process Started');\
"]
